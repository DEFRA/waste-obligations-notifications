{
  "docker": {
    "host": "http://localhost:8085",
    "authorization": "Basic docker development-only-http-runbook-secret"
  },
  "dev": {
    "authorization": "Bearer {{$auth.token(\"service\")}}",
    "Security": {
      "Auth": {
        "service": {
          "Type": "OAuth2",
          "Grant Type": "Client Credentials",
          "Token URL": "{{tokenEndpoint}}",
          "Client ID": "{{clientId}}",
          "Client Secret": "{{clientSecret}}",
          "Client Credentials": "basic"
        }
      }
    }
  },
  "test": {
