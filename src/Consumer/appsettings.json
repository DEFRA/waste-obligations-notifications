    "ReceiveTimeoutSeconds": 30,
    "ReadTimeoutSeconds": 20,
    "PublishTimeoutSeconds": 10,
    "DeleteTimeoutSeconds": 5,
    "SafetyHeadroomSeconds": 10,
    "VisibilityTimeoutSeconds": 90
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "formatter": "Elastic.CommonSchema.Serilog.EcsTextFormatter, Elastic.CommonSchema.Serilog"
              }
            }
          ]
        }
      }
    ]
  },
  "NotificationCommandDelivery": {
    "QueueUrl": "set-automatically-when-deployed",
    "EmailDeliveryCutoverUtc": null,
    "EvidenceDigestSecret": "set-automatically-when-deployed",
    "RecipientLaneSecret": "set-automatically-when-deployed",
    "WaitTimeSeconds": 20,
    "ReceiveTimeoutSeconds": 30,
    "PollIntervalSeconds": 15,
    "VisibilityTimeoutSeconds": 120,
    "CommandLeaseSeconds": 90,
    "ClaimTimeoutSeconds": 5,
    "NotifyTimeoutSeconds": 60,
    "AcceptanceTimeoutSeconds": 10,
    "DeleteTimeoutSeconds": 5,
    "SafetyHeadroomSeconds": 10,
    "DiagnosticNotificationTypes": [
      "declaration-submitted-direct-en",
      "declaration-submitted-direct-cy",
      "declaration-submitted-scheme-en",
      "declaration-submitted-scheme-cy"
    ]
  },
  "MongoMigrations": {
