{
  "AllowedHosts": "*",
  "TraceHeader": "x-cdp-request-id",
  "AnalyticsEventConsumer": {
    "ProcessingEnabled": false,
    "QueueUrl": "set-automatically-when-deployed",
    "BatchSize": 10,
    "WaitTimeSeconds": 20,
    "PollIntervalSeconds": 15
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "formatter": "Elastic.CommonSchema.Serilog.EcsTextFormatter, Elastic.CommonSchema.Serilog"
              }
            }
          ]
        }
      }
    ]
  },
  "NotificationCommandDelivery": {
    "ProcessingEnabled": false,
    "QueueUrl": "set-automatically-when-deployed",
    "EmailDeliveryCutoverUtc": "set-automatically-when-deployed",
    "EvidenceDigestSecret": "set-automatically-when-deployed",
    "RecipientLaneSecret": "set-automatically-when-deployed",
    "MongoConnectionString": "set-automatically-when-deployed",
    "MongoDatabaseName": "set-automatically-when-deployed",
    "BatchSize": 1,
    "WaitTimeSeconds": 20,
    "PollIntervalSeconds": 15
  },
  "MongoMigrations": {
    "LeaseDurationSeconds": 60,
    "LeaseRenewalIntervalSeconds": 15,
    "AttemptTimeoutSeconds": 300,
    "RetryDelaySeconds": 30,
    "LeaseAcquisitionAlertThresholdSeconds": 300,
    "MaximumAttempts": 3
  }
}
