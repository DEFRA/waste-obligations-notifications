{
  "AllowedHosts": "*",
  "TraceHeader": "x-cdp-request-id",
  "AnalyticsEventConsumer": {
    "ProcessingEnabled": false,
    "QueueUrl": "set-automatically-when-deployed",
    "BatchSize": 10,
    "WaitTimeSeconds": 20,
    "PollIntervalSeconds": 15
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "formatter": "Elastic.CommonSchema.Serilog.EcsTextFormatter, Elastic.CommonSchema.Serilog"
              }
            }
          ]
        }
      }
    ]
  },
  "NotificationCommandDelivery": {
    "ProcessingEnabled": false,
    "QueueUrl": "set-automatically-when-deployed",
    "EmailDeliveryCutoverUtc": null,
    "EvidenceDigestSecret": "set-automatically-when-deployed",
    "RecipientLaneSecret": "set-automatically-when-deployed",
    "BatchSize": 1,
    "WaitTimeSeconds": 20,
    "ReceiveTimeoutSeconds": 30,
    "PollIntervalSeconds": 15,
    "VisibilityTimeoutSeconds": 120,
    "CommandLeaseSeconds": 90,
    "ClaimTimeoutSeconds": 5,
    "NotifyTimeoutSeconds": 60,
    "AcceptanceTimeoutSeconds": 10,
    "DeleteTimeoutSeconds": 5,
    "SafetyHeadroomSeconds": 10,
    "DiagnosticNotificationTypes": []
  },
  "MongoMigrations": {
    "LeaseDurationSeconds": 30,
    "LeaseRenewalIntervalSeconds": 10,
    "CriticalOperationTimeoutSeconds": 20,
    "AttemptTimeoutSeconds": 300,
    "RetryDelaySeconds": 30,
    "LeaseAcquisitionAlertThresholdSeconds": 300,
    "MaximumAttempts": 3
  },
  "Mongo": {
    "DatabaseUri": "set-automatically-when-deployed",
    "DatabaseName": "waste-obligations-notifications"
  },
  "Notify": {
    "ApiKey": "set-automatically-when-deployed",
    "BaseAddress": "https://api.notifications.service.gov.uk"
  },
  "AWS_EMF_ENABLED": true,
  "AWS_EMF_NAMESPACE": "set-automatically-when-deployed",
  "AWS_EMF_ENVIRONMENT": "",
  "CommandDlqAdministration": {
    "Enabled": false,
    "QueueUrl": "set-automatically-when-deployed",
    "SelectionLifetimeSeconds": 120,
    "DependencyTimeoutSeconds": 10
  },
  "Acl": {
    "Clients": {}
  }
}
