{
  "DetailedErrors": true,
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:o} [{Level:u4}] {Message} {Properties}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AnalyticsEventConsumer": {
    "ProcessingEnabled": true,
    "QueueUrl": "http://localhost:4566/000000000000/waste_obligations_notifications_analytics_events_queue",
    "WaitTimeSeconds": 1,
    "PollIntervalSeconds": 1,
    "ReceiveTimeoutSeconds": 30,
    "ReadTimeoutSeconds": 60,
    "PublishTimeoutSeconds": 30,
    "DeleteTimeoutSeconds": 5,
    "SafetyHeadroomSeconds": 10,
    "VisibilityTimeoutSeconds": 150
  },
  "NotificationCommandDelivery": {
    "QueueUrl": "http://localhost:4566/000000000000/waste_obligations_notifications_commands.fifo",
    "EmailDeliveryCutoverUtc": "2100-01-01T00:00:00Z",
    "EvidenceDigestSecret": "development-only-evidence-digest-secret",
    "RecipientLaneSecret": "development-only-recipient-lane-secret",
    "WaitTimeSeconds": 1,
    "ReceiveTimeoutSeconds": 30,
    "PollIntervalSeconds": 1,
    "VisibilityTimeoutSeconds": 120,
    "CommandLeaseSeconds": 90,
    "ClaimTimeoutSeconds": 5,
    "NotifyTimeoutSeconds": 60,
    "AcceptanceTimeoutSeconds": 10,
    "DeleteTimeoutSeconds": 5,
    "SafetyHeadroomSeconds": 10,
    "DiagnosticNotificationTypes": [
      "declaration-submitted",
      "declaration-cancelled",
      "declaration-submitted-direct-en",
      "declaration-submitted-direct-cy",
      "declaration-submitted-scheme-en",
      "declaration-submitted-scheme-cy",
      "declaration-cancelled-not-signed-by-correct-person-en",
      "declaration-cancelled-not-signed-by-correct-person-cy",
      "declaration-cancelled-recycling-obligations-changed-en",
      "declaration-cancelled-recycling-obligations-changed-cy",
      "declaration-cancelled-can-meet-recycling-obligations-en",
      "declaration-cancelled-can-meet-recycling-obligations-cy",
      "declaration-cancelled-producer-requested-en",
      "declaration-cancelled-producer-requested-cy",
      "declaration-not-submitted-reminder-en",
      "declaration-not-submitted-reminder-cy",
      "declaration-not-submitted-reminder-2-en",
      "declaration-not-submitted-reminder-2-cy"
    ]
  },
  "MongoMigrations": {
    "LeaseDurationSeconds": 30,
    "LeaseRenewalIntervalSeconds": 10,
    "CriticalOperationTimeoutSeconds": 20,
    "AttemptTimeoutSeconds": 300,
    "RetryDelaySeconds": 30,
    "LeaseAcquisitionAlertThresholdSeconds": 300,
    "MaximumAttempts": 3
  },
  "Mongo": {
    "DatabaseUri": "mongodb://mongo:27017"
  },
  "Notify": {
    "ApiKey": "provided-at-runtime-by-local-notify-fixture",
    "BaseAddress": "http://notify-fixture:8080"
  },
  "AWS_EMF_ENABLED": false,
  "CommandDlqAdministration": {
    "QueueUrl": "http://localhost:4566/000000000000/waste_obligations_notifications_commands_dlq.fifo"
  },
  "WasteObligations": {
    "BaseAddress": "http://localhost:8081",
    "Username": "local-notifications-read",
    "Password": "development-only-read-secret"
  },
  "WasteOrganisations": {
    "BaseAddress": "http://localhost:8082",
    "Username": "local-notifications-read",
    "Password": "development-only-secret"
  },
  "AccountBackend": {
